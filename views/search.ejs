<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head><meta charset="UTF-8"><title>نتائج البحث</title></head>
<body>
 <div class="page-content-listing">
 <% results.forEach(novel => { %>
 <div class="c-tabs-item__content">
 <div class="tab-thumb c-image-hover">
 <a href="/novel/<%= novel.id || novel._id %>">
 <img src="<%= novel.coverImage || novel.cover_url || novel.cover %>" alt="<%= novel.title %>">
 </a>
 </div>
 <div class="tab-summary">
 <div class="post-title">
 <h3><a href="/novel/<%= novel.id || novel._id %>"><%= novel.title %></a></h3>
 </div>
 </div>
 </div>
 <% }) %>
 </div>
</body>
</html>
