<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <title>سماء الروايات</title>
</head>
<body class="home-page">
    <div class="main-col">
        <div class="page-content-listing">
            <div class="page-listing-item">
                <div class="row">
                    <% novels.forEach(novel => { %>
                    <div class="page-item-detail">
                        <div class="item-thumb">
                            <a href="/novel/<%= novel._id || novel.id %>">
                                <img src="<%= novel.coverImage || novel.cover_url || novel.cover %>" alt="<%= novel.title %>">
                            </a>
                        </div>
                        <div class="item-summary">
                            <div class="post-title">
                                <h3><a href="/novel/<%= novel._id || novel.id %>"><%= novel.title %></a></h3>
                            </div>
                        </div>
                    </div>
                    <% }) %>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
