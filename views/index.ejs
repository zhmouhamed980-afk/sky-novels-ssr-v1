<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head><meta charset="UTF-8"><title>سماء الروايات</title></head>
<body class="home">
    <div class="wrap">
        <div class="body">
            <div class="main-col">
                <div class="page-content-listing">
                    <div class="page-listing-item">
                        <div class="row">
                            <% novels.forEach(novel => { %>
                            <div class="col-xs-6 col-sm-4 col-md-3 page-item-detail">
                                <div class="item-thumb">
                                    <a href="/novel/<%= novel._id || novel.id %>" title="<%= novel.title %>">
                                        <img src="<%= novel.coverImage || novel.cover_url || novel.cover %>" class="img-responsive" alt="<%= novel.title %>">
                                    </a>
                                </div>
                                <div class="item-summary">
                                    <div class="post-title font-title">
                                        <h5><a href="/novel/<%= novel._id || novel.id %>"><%= novel.title %></a></h5>
                                    </div>
                                </div>
                            </div>
                            <% }) %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
