<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <title><%= novel.title %></title>
    <style>
        body { font-family: sans-serif; max-width: 800px; margin: 0 auto; padding: 20px; line-height: 1.6; }
        .header { display: flex; gap: 20px; margin-bottom: 30px; }
        .header img { width: 200px; border-radius: 8px; }
        .meta { color: #666; margin-bottom: 10px; }
        .tag { background: #eee; padding: 2px 8px; border-radius: 10px; font-size: 0.9em; margin-right: 5px; }
        .chapters-list { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; list-style: none; padding: 0; }
        .chapters-list li a { display: block; padding: 10px; background: #f9f9f9; border: 1px solid #eee; border-radius: 4px; text-decoration: none; color: #007bff; }
    </style>
</head>
<body>
    <a href="/">← العودة للرئيسية</a>
    <div class="header">
        <img src="<%= novel.cover_url || novel.cover %>" alt="<%= novel.title %>">
        <div>
            <h1><%= novel.title %></h1>
            <div class="meta">
                <span>الحالة: <%= novel.is_completed ? 'مكتملة' : 'مستمرة' %></span> | 
                <span>المؤلف: <%= novel.author || 'غير معروف' %></span>
            </div>
            <div class="tags">
                <% (novel.tags || novel.categories || []).forEach(tag => { %>
                    <span class="tag"><%= tag %></span>
                <% }) %>
            </div>
        </div>
    </div>

    <h3>الوصف:</h3>
    <p><%= novel.description || novel.summary %></p>

    <h3>قائمة الفصول:</h3>
    <ul class="chapters-list">
        <% if (novel.chapters) { %>
            <% novel.chapters.forEach(ch => { %>
                <li>
                    <a href="/novel/<%= novel.id %>/chapter/<%= ch.number || ch.chapterNum %>">
                        <%= ch.title || ('الفصل ' + (ch.number || ch.chapterNum)) %>
                    </a>
                </li>
            <% }) %>
        <% } %>
    </ul>
</body>
</html>
