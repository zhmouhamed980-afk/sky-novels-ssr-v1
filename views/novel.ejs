<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head><meta charset="UTF-8"><title><%= novel.title %></title></head>
<body class="novel-page">
 <div class="post-title"><h1><%= novel.title %></h1></div>
 <div class="summary_image">
 <img src="<%= novel.coverImage || novel.cover_url || novel.cover %>" alt="<%= novel.title %>">
 </div>
 <div class="post-content">
 <div class="post-status">
 <div class="post-content_item">
 <div class="summary-heading">الحالة</div>
 <div class="summary-content">
 <%= novel.status === 'مكتملة' || novel.is_completed ? 'Completed' : 'OnGoing' %>
 </div>
 </div>
 </div>
 <div class="genres-content">
 <% (novel.tags || novel.categories || []).forEach(tag => { %>
 <a href="#"><%= tag %></a>
 <% }) %>
 </div>
 <div class="author-content">
 <a href="#"><%= novel.author || 'غير معروف' %></a>
 </div>
 </div>
 <div class="summary__content" id="editdescription">
 <p><%= novel.description || novel.summary %></p>
 </div>
 <div class="page-content-listing single-page">
 <ul class="main version-chap">
 <% if (novel.chapters && novel.chapters.length > 0) { %>
 <% novel.chapters.forEach(ch => { %>
 <li class="wp-manga-chapter">
 <a href="/novel/<%= novel.id || novel._id %>/chapter/<%= ch.number || ch.chapterNum || ch.id %>">
 <%= ch.title || ('الفصل ' + (ch.number || ch.chapterNum)) %>
 </a>
 </li>
 <% }) %>
 <% } else { %>
 <% for(let i=1; i <= (novel.totalChapters || 0); i++) { %>
 <li class="wp-manga-chapter">
 <a href="/novel/<%= novel.id || novel._id %>/chapter/<%= i %>">
 الفصل <%= i %>
 </a>
 </li>
 <% } %>
 <% } %>
 </ul>
 </div>
</body>
</html>
