<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head><meta charset="UTF-8"><title><%= (typeof chapter !== 'undefined' && chapter.title) ? chapter.title : ('الفصل ' + chapterNum) %></title></head>
<body class="chapter-page">
 <div class="c-blog-post">
 <div class="entry-header">
 <h1 id="chapter-heading"><%= (typeof chapter !== 'undefined' && chapter.title) ? chapter.title : ('الفصل ' + chapterNum) %></h1>
 </div>
 <div class="reading-content">
 <div class="text-left">
 <%- (typeof chapter !== 'undefined' && chapter.content) ? chapter.content : '' %>
 </div>
 </div>
 <div class="nav-links">
 <% if (chapterNum > 1) { %>
 <div class="nav-previous">
 <a href="/novel/<%= novelId %>/chapter/<%= chapterNum - 1 %>">Prev</a>
 </div>
 <% } %>
 <div class="nav-next">
 <a href="/novel/<%= novelId %>/chapter/<%= chapterNum + 1 %>">Next</a>
 </div>
 </div>
 </div>
</body>
</html>
