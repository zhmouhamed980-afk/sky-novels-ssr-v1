<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <title><%= chapter.title %></title>
</head>
<body class="wp-manga-template-default">
    <div class="read-container">
        <div class="reading-content">
            <div class="text-left">
                <%- chapter.content %>
            </div>
        </div>
        <div class="nav-links">
            <div class="nav-previous">
                <% if (chapterNum > 1) { %>
                <a href="/novel/<%= novelId %>/chapter/<%= chapterNum - 1 %>" class="prev_page">الفصل السابق</a>
                <% } %>
            </div>
            <div class="nav-next">
                <a href="/novel/<%= novelId %>/chapter/<%= chapterNum + 1 %>" class="next_page">الفصل التالي</a>
            </div>
        </div>
    </div>
</body>
</html>
